# Anthropic (Analysis Agent)
ANTHROPIC_API_KEY=

# Pinecone (serverless free tier)
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=us-east-1
PINECONE_INDEX_NAME=ma-dd-analyzer

# Embeddings — local sentence-transformers, 1024-dim.  Queries must be embedded
# with the same model as the indexed chunks; changing these means re-indexing.
# Pinecone index dimension MUST match EMBEDDING_DIMENSION.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Gemini embeddings (only with EMBEDDING_PROVIDER=google)
# GOOGLE_API_KEY=
# EMBEDDING_MODEL=models/gemini-embedding-001

# Analysis model.  There is no temperature setting: Claude Sonnet 5.5 rejects a
# non-default temperature.  LLM_EFFORT is low | medium | high | xhigh | max.
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=high
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=300

# Retrieval settings
RETRIEVAL_TOP_K=8
CONFIDENCE_THRESHOLD=0.60
SECTION_BOOST_WEIGHT=0.2

# Chunking settings
CHUNK_SIZE=768
CHUNK_OVERLAP=50

# LangSmith tracing (smith.langchain.com).  Tracing uploads prompts, including
# filing text; it stays off unless this is true AND a real API key is set.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=ma-dd-analyzer

# MLflow experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=dd-analyzer-eval

# SEC EDGAR API (XBRL companyfacts, full-text search). SEC requires a User-Agent
# naming who is making requests: "<Your Name> <contact email>".
SEC_USER_AGENT=Your Name you@example.com
